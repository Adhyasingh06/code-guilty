private double seededRandom() {
    seed = (seed * 9301 + 49297) % 233280;
    return (double) seed / 233280;
}

    // ── CASE GENERATION ──────────────────────

    private void generateCase() {
    caseFile.suspects.clear();
    caseFile.evidences.clear();

    List<String> names = new ArrayList<>(Arrays.asList(namePool));

    shuffleList(names); // ✔️ first shuffle names

    // Create suspects
    for (int i = 0; i < 4; i++) {
        String randomPersonality =
            personalityPool[(int)(seededRandom() * personalityPool.length)];

        caseFile.suspects.add(new Suspect(names.get(i), randomPersonality));
    }

    shuffleList(caseFile.suspects); // ✔️ shuffle suspects

    // Random culprit
    realCulprit = caseFile.suspects
        .get((int)(seededRandom() * caseFile.suspects.size()))
        .getName();

    int caseType = (int)(seededRandom() * 3);

    switch (caseType) {
        case 0 -> generateCase0();
        case 1 -> generateCase1();
        default -> generateCase2();
    }
}
// ✔️ Place this inside GameEngine class (but OUTSIDE any method)
private void shuffleList(List<?> list) {
    for (int i = list.size() - 1; i > 0; i--) {
        int j = (int)(seededRandom() * (i + 1));
        Collections.swap(list, i, j);
    }
}

