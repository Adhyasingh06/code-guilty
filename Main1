//  THREAD UTILITIES


class TypewriterThread extends Thread {
    private final String text;
    private final int delay;

    public TypewriterThread(String text, int delayMs) {
        this.text  = text;
        this.delay = delayMs;
    }

    @Override
    public void run() {
        for (char c : text.toCharArray()) {
            System.out.print(c);
            System.out.flush();
            try {
                Thread.sleep(delay);
            } catch (InterruptedException e) {
                Thread.currentThread().interrupt();
                break;
            }
        }
        System.out.println();
    }
}

class SpinnerThread extends Thread {
    private final String label;
    private final AtomicBoolean running = new AtomicBoolean(true);
    private final String[] frames = {"⠋","⠙","⠸","⠴","⠦","⠇"};

    public SpinnerThread(String label) {
        this.label = label;
        setDaemon(true);
    }

    public void stopSpinner() {
        running.set(false);
    }

    @Override
    public void run() {
        int i = 0;
        while (running.get()) {
            System.out.print("\r" + frames[i % frames.length] + " " + label + "  ");
            System.out.flush();
            try {
                Thread.sleep(100);
            } catch (InterruptedException e) {
                Thread.currentThread().interrupt();
                break;
            }
            i++;
        }
        System.out.print("\r");
        System.out.flush();
    }
}

// Background hint thread that periodically nudges the player
class HintThread extends Thread {
    private final AtomicBoolean running = new AtomicBoolean(true);
    private final String[] hints = {
        "💡 Tip: Interrogate nervous suspects — pressure reveals cracks.",
        "💡 Tip: Check all evidence before accusing.",
        "💡 Tip: Compare suspicion scores in your notebook.",
        "💡 Tip: The real culprit's alibi might seem too clean.",
        "💡 Tip: Examine evidence carefully — weak clues mislead."
    };
    private final Random rand = new Random();

    public HintThread() {
        setDaemon(true);
    }

    public void stopHints() {
        running.set(false);
    }

    @Override
    public void run() {
        try {
            Thread.sleep(20_000); // first hint after 20 sec
            while (running.get()) {
                System.out.println("\n" + hints[rand.nextInt(hints.length)]);
                Thread.sleep(30_000); // then every 30 sec
            }
        } catch (InterruptedException e) {
            Thread.currentThread().interrupt();
        }
    }
}

