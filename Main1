    // ── ACTIONS ──────────────────────────────

    private void viewSuspects() {
        System.out.println("\n👥 SUSPECTS");
        System.out.println("─────────────────────────────────────────────────────");
        for (Suspect s : caseFile.suspects) {
            String tag = s.isInterrogated() ? "✔ Interrogated" : "  Not yet questioned";
            System.out.printf("  %-8s | %-12s | [%s] | %s%n",
                s.getName(), s.getPersonality(), s.suspicionBar(), tag);
        }
        System.out.println("─────────────────────────────────────────────────────");
        notebook.log("Reviewed suspect list.");
    }

    private void interrogate() throws SuspectNotFoundException, InvalidInputException {
        String name = readString("Enter suspect name: ");
        if (name.isBlank()) throw new InvalidInputException("Suspect name cannot be empty.");

        Suspect found = null;
        for (Suspect s : caseFile.suspects) {
            if (s.getName().equalsIgnoreCase(name)) { found = s; break; }
        }
        if (found == null) throw new SuspectNotFoundException(name);

        final Suspect suspect = found;

        // Suspense delay in a separate thread
        SpinnerThread spinner = new SpinnerThread("Interrogating " + suspect.getName());
        spinner.start();
        try { Thread.sleep(1800); } catch (InterruptedException e) { Thread.currentThread().interrupt(); }
        spinner.stopSpinner();
        try { Thread.sleep(200); } catch (InterruptedException e) { Thread.currentThread().interrupt(); }

        // Suspicion based on personality
        switch (suspect.getPersonality()) {
            case "Nervous"     -> suspect.increaseSuspicion(15);
            case "Aggressive"  -> suspect.increaseSuspicion(10);
            case "Calculating" -> suspect.increaseSuspicion(12);
            default            -> suspect.increaseSuspicion(5);
        }
        suspect.markInterrogated();

        System.out.println("\n🗣  " + suspect.getName() + "'s Statement:");
        System.out.println("─────────────────────────────");

        // Typewriter for alibi
        TypewriterThread tw = new TypewriterThread(suspect.getAlibi(), 18);
        tw.start();
        try { tw.join(); } catch (InterruptedException e) { Thread.currentThread().interrupt(); }

        System.out.println("─────────────────────────────");
        System.out.println("  Personality aura: " + suspect.getPersonality() +
            " | Suspicion score now: " + suspect.getSuspicionScore());

        notebook.log("Interrogated " + suspect.getName() +
            " [" + suspect.getPersonality() + "] — alibi obtained.");
    }

    private void viewEvidence() {
        System.out.println("\n🔍 EVIDENCE LOCKER");
        System.out.println("══════════════════════════════════");

        ExecutorService pool = Executors.newFixedThreadPool(2);

        for (Evidence e : caseFile.evidences) {
            pool.submit(() -> {
                synchronized (System.out) {
                    if (!e.isExamined()) {
                        e.markExamined();
                        System.out.println("\n  " + e.getDescription());
                        System.out.println("  → " + e.getExplanation());

                        // Update suspicion scores
                        for (Suspect s : caseFile.suspects) {
                            if (s.getName().equals(e.getRelatedSuspect())) {
                                if (s.getName().equals(realCulprit))
                                    s.increaseSuspicion(25);
                                else
                                    s.increaseSuspicion(8);
                            }
                        }
                    } else {
                        System.out.println("  [Already examined] " + e.getDescription());
                    }
                }
            });
        }

        pool.shutdown();
        try {
            if (!pool.awaitTermination(10, TimeUnit.SECONDS)) {
                pool.shutdownNow();
            }
        } catch (InterruptedException ex) {
            pool.shutdownNow();
            Thread.currentThread().interrupt();
        }

        System.out.println("══════════════════════════════════");
        notebook.log("Examined evidence locker.");
    }

    private void viewHint() {
        score = Math.max(0, score - 5); // hint costs points

        // Find highest suspicion suspect
        Suspect topSuspect = caseFile.suspects.stream()
            .max(Comparator.comparingInt(Suspect::getSuspicionScore))
            .orElse(null);

        if (topSuspect != null) {
            System.out.println("\n🔎 HINT: The data points most strongly toward " +
                topSuspect.getName() + " (score: " + topSuspect.getSuspicionScore() + ").");
            System.out.println("   But don't rely on this alone — investigate further.");
        } else {
            System.out.println("🔎 HINT: Examine all evidence and interrogate all suspects first.");
        }
        notebook.log("Requested a hint.");
    }

    private void accuse() throws InvalidInputException {
        String name = readString("\n⚖  Who do you accuse? Enter name: ");
        if (name.isBlank()) throw new InvalidInputException("You must name a suspect.");

        boolean validSuspect = caseFile.suspects.stream()
            .anyMatch(s -> s.getName().equalsIgnoreCase(name));
        if (!validSuspect) throw new InvalidInputException("'" + name + "' is not a valid suspect.");

        long elapsed = (System.currentTimeMillis() - startTime) / 1000;
        int timeBonus = elapsed < 120 ? 20 : (elapsed < 300 ? 10 : 0);

        System.out.println("\n┌──────────────────────────────────────┐");
        System.out.println("│            VERDICT                   │");
        System.out.println("└──────────────────────────────────────┘");

        if (name.equalsIgnoreCase(realCulprit)) {
            score += timeBonus;
            System.out.println("✔  CORRECT! " + name + " breaks down and confesses.");
            System.out.println("\n  \"I didn't mean for it to go that far...");
            System.out.println("   The argument got out of hand.");
            System.out.println("   I panicked. I'm sorry.\"\n");
            System.out.println("  🏆 CASE CLOSED — Justice served.");
            System.out.println("  ⏱  Time: " + elapsed + "s | Actions: " + actionCount);
            System.out.println("  ⭐ Final Score: " + score + (timeBonus > 0 ? " (+" + timeBonus + " speed bonus)" : ""));
        } else {
            score = Math.max(0, score - 30);
            System.out.println("✖  WRONG! " + name + " has a confirmed alibi.");
            System.out.println("   The real culprit was: " + realCulprit);
            System.out.println("   They escaped while you were distracted.");
            System.out.println("  ⭐ Final Score: " + score + " (−30 wrong accusation)");
        }

        notebook.display();
        offerReplay();
    }

    private void offerReplay() {
        System.out.print("\nPlay again? (yes/no): ");
        try {
            String input = sc.nextLine().trim();
            if (input.equalsIgnoreCase("yes") || input.equalsIgnoreCase("y")) {
                // Reset and restart
                caseFile.suspects.clear();
                caseFile.evidences.clear();
                score = 100;
                actionCount = 0;
                generateCase();
                start();
            } else {
                System.out.println("\nThe truth was found today. Until next time, Detective.");
            }
        } catch (NoSuchElementException e) {
            System.out.println("\nGoodbye, Detective.");
        }
    }

    // ── INPUT HELPERS ────────────────────────

    private int readInt(String prompt) throws InvalidInputException {
        System.out.print(prompt);
        try {
            String line = sc.nextLine().trim();
            return Integer.parseInt(line);
        } catch (NumberFormatException e) {
            throw new InvalidInputException("Please enter a valid number.");
        } catch (NoSuchElementException e) {
            throw new InvalidInputException("Input stream ended unexpectedly.");
        }
    }

    private String readString(String prompt) {
        System.out.print(prompt);
        try {
            return sc.nextLine().trim();
        } catch (NoSuchElementException e) {
            return "";
        }
    }
