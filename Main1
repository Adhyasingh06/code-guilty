    // Helper to add evidence
    private void addEvidence(String strongTitle, String strongExplanation, String weakExplanation) {
        for (Suspect s : caseFile.suspects) {
            if (s.getName().equals(realCulprit)) {
                caseFile.evidences.add(new Evidence(strongTitle, strongExplanation, s.getName()));
            } else {
                caseFile.evidences.add(new Evidence("🔍 Minor clue", weakExplanation + " (" + s.getName() + ")", s.getName()));
            }
        }
    }

    // (REST OF YOUR CODE REMAINS EXACTLY SAME — no changes needed)


    // ── GAME LOOP ────────────────────────────

    public void start() {
        intro();
        startTime = System.currentTimeMillis();

        HintThread hintThread = new HintThread();
        hintThread.start();

        int choice = -1;
        do {
            printMenu();
            try {
                choice = readInt("Choose action: ");
                handleChoice(choice);
            } catch (InvalidInputException e) {
                System.out.println("⚠  " + e.getMessage());
            }
        } while (choice != 6);

        hintThread.stopHints();
    }

    private void handleChoice(int choice) throws InvalidInputException {
        actionCount++;
        score = Math.max(0, score - 2); // small penalty per action

        switch (choice) {
            case 1 -> viewSuspects();
            case 2 -> {
                try { interrogate(); }
                catch (SuspectNotFoundException | InvalidInputException e) {
                    System.out.println("⚠  " + e.getMessage());
                }
            }
            case 3 -> viewEvidence();
            case 4 -> viewHint();
            case 5 -> notebook.display();
            case 6 -> {
                try { accuse(); }
                catch (InvalidInputException e) {
                    System.out.println("⚠  " + e.getMessage());
                    score = Math.max(0, score - 10);
                }
            }
            default -> throw new InvalidInputException("Choose a number between 1 and 6.");
        }
    }

