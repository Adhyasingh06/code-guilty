//  PERSON BASE CLASS


class Person {
    protected String name;

    public Person(String name) {
        this.name = name;
    }

    public String getName() {
        return name;
    }
}

//  SUSPECT CLASS


class Suspect extends Person {
    String alibi;
    private int suspicionScore;
    private final String personality;
    private boolean interrogated = false;

    public Suspect(String name, String personality) {
        super(name);
        this.personality = personality;
        this.suspicionScore = 0;
    }

    public String getAlibi()         { return alibi; }
    public String getPersonality()   { return personality; }
    public int getSuspicionScore()   { return suspicionScore; }
    public boolean isInterrogated()  { return interrogated; }
    public void markInterrogated()   { interrogated = true; }

    public void increaseSuspicion(int points) {
        suspicionScore += points;
    }

    // Visual suspicion bar
    public String suspicionBar() {
        int bars = Math.min(suspicionScore / 5, 20);
        return "█".repeat(bars) + "░".repeat(20 - bars) + " " + suspicionScore + " pts";
    }
}

//  EVIDENCE CLASS


class Evidence {
    private final String description;
    private final String explanation;
    private final String relatedSuspect;
    private boolean examined = false;

    public Evidence(String description, String explanation, String relatedSuspect) {
        this.description = description;
        this.explanation = explanation;
        this.relatedSuspect = relatedSuspect;
    }

    public String getDescription()   { return description; }
    public String getExplanation()   { return explanation; }
    public String getRelatedSuspect(){ return relatedSuspect; }
    public boolean isExamined()      { return examined; }
    public void markExamined()       { examined = true; }
}

//  NOTEBOOK — TRACKS DETECTIVE PROGRESS


class DetectiveNotebook {
