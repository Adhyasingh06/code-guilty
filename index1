// ═══════════════════════════════════════════════════════
//  EVENT LISTENERS
// ═══════════════════════════════════════════════════════
document.getElementById('btn-new-case').addEventListener('click', startNewGame);

// ── CHANGE 8 ──────────────────────────────────────────────────────────────
// Nav button clicks now call showPanel with chargeAction=true so each
// panel switch costs -2 pts and +1 action, matching Java's menu action cost.
document.querySelectorAll('[data-panel]').forEach(btn => {
  btn.addEventListener('click', () => {
    const panel = btn.getAttribute('data-panel');
    showPanel(panel, true);
    if (panel !== 'suspects') renderSuspects();
    if (panel !== 'evidence') renderEvidence();
  });
});
// ─────────────────────────────────────────────────────────────────────────

document.getElementById('btn-hint').addEventListener('click', requestHint);
document.getElementById('btn-confirm-accuse').addEventListener('click', confirmAccusation);
document.getElementById('modal-close-btn').addEventListener('click', () => {
  document.getElementById('modal-interrogate').classList.remove('open');
});
document.getElementById('modal-interrogate').addEventListener('click', (e) => {
  if (e.target === e.currentTarget)
    document.getElementById('modal-interrogate').classList.remove('open');
});
