
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>CODE: GUILTY — Detective Game</title>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400;1,700&family=Courier+Prime:ital,wght@0,400;0,700;1,400&family=Bebas+Neue&display=swap" rel="stylesheet"/>
<style>
  :root {
    --ink: #0d0b08;
    --paper: #f5f0e8;
    --paper-dark: #ede6d6;
    --paper-mid: #e8e0cc;
    --accent: #c8392b;
    --accent-dark: #8b2218;
    --gold: #b8962a;
    --gold-light: #d4af47;
    --muted: #6b6055;
    --muted-light: #9a8f82;
    --border: #c4b89a;
    --border-light: #d8cdb6;
    --shadow: rgba(13,11,8,0.18);
    --green-clue: #2d6a4f;
    --red-alert: #c8392b;
    --scan-line: rgba(13,11,8,0.04);
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html { font-size: 16px; }

  body {
    font-family: 'Courier Prime', 'Courier New', monospace;
    background: var(--ink);
    color: var(--paper);
    min-height: 100vh;
    overflow-x: hidden;
  }

  body::before {
    content: '';
    position: fixed;
    inset: 0;
    background: repeating-linear-gradient(0deg, var(--scan-line) 0px, var(--scan-line) 1px, transparent 1px, transparent 3px);
    pointer-events: none;
    z-index: 9999;
  }

  body::after {
    content: '';
    position: fixed;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.03'/%3E%3C/svg%3E");
    pointer-events: none;
    z-index: 9998;
    opacity: 0.4;
  }

  .screen { display: none; min-height: 100vh; }
  .screen.active { display: flex; flex-direction: column; }

  #screen-title {
    align-items: center;
    justify-content: center;
    background: radial-gradient(ellipse at 50% 30%, #1a1208 0%, #0d0b08 70%);
    position: relative;
    overflow: hidden;
  }
  #screen-title .bg-tape {
    position: absolute;
    background: rgba(200,57,43,0.08);
    transform: rotate(-2deg);
    width: 200%;
    height: 3px;
    top: 38%;
  }
  .title-badge {
    font-family: 'Courier Prime', monospace;
    font-size: 11px;
    letter-spacing: 0.35em;
    color: var(--gold);
    text-transform: uppercase;
    margin-bottom: 1.5rem;
    opacity: 0.8;
  }
  .title-main {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(72px, 14vw, 140px);
    letter-spacing: 0.05em;
    line-height: 0.85;
    color: var(--paper);
    text-shadow: 4px 4px 0 var(--accent-dark), 8px 8px 0 rgba(0,0,0,0.4);
    margin-bottom: 0.4rem;
  }
  .title-sub {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(28px, 5vw, 52px);
    letter-spacing: 0.3em;
    color: var(--accent);
    margin-bottom: 3rem;
  }
  .title-divider {
    width: 200px;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--gold), transparent);
    margin: 0 auto 2.5rem;
  }
  .title-tagline {
    font-family: 'Playfair Display', serif;
    font-style: italic;
    font-size: 17px;
    color: var(--muted-light);
    margin-bottom: 3rem;
    max-width: 440px;
    text-align: center;
    line-height: 1.6;
  }

  .btn {
    font-family: 'Courier Prime', monospace;
    font-size: 13px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    padding: 14px 36px;
    border: 1px solid var(--gold);
    background: transparent;
    color: var(--gold);
    cursor: pointer;
    transition: all 0.2s;
    position: relative;
  }
  .btn::before {
    content: '';
    position: absolute;
    inset: 3px;
    border: 1px solid rgba(184,150,42,0.25);
  }
  .btn:hover {
    background: var(--gold);
    color: var(--ink);
    transform: translateY(-1px);
    box-shadow: 0 4px 20px rgba(184,150,42,0.25);
  }
  .btn:active { transform: translateY(0); }
  .btn-danger {
    border-color: var(--accent);
    color: var(--accent);
  }
  .btn-danger::before { border-color: rgba(200,57,43,0.25); }
  .btn-danger:hover { background: var(--accent); color: var(--paper); box-shadow: 0 4px 20px rgba(200,57,43,0.3); }
  .btn-sm { padding: 8px 20px; font-size: 11px; }
  .btn-ghost {
    border-color: rgba(245,240,232,0.2);
    color: var(--muted-light);
  }
  .btn-ghost::before { display: none; }
  .btn-ghost:hover { background: rgba(245,240,232,0.08); color: var(--paper); box-shadow: none; }

  #screen-loading {
    align-items: center;
    justify-content: center;
    background: var(--ink);
  }
  .loading-case {
    text-align: center;
    max-width: 500px;
  }
  .loading-stamp {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 80px;
    color: var(--accent);
    opacity: 0.15;
    letter-spacing: 0.05em;
    line-height: 1;
    margin-bottom: 1rem;
  }
  .loading-label {
    font-size: 11px;
    letter-spacing: 0.3em;
    color: var(--gold);
    margin-bottom: 1rem;
  }
  #loading-status {
    font-family: 'Playfair Display', serif;
    font-style: italic;
    font-size: 18px;
    color: var(--muted-light);
    min-height: 28px;
  }
  .loading-dots::after {
    content: '';
    animation: dots 1.5s infinite;
  }
  @keyframes dots {
    0%   { content: ''; }
    25%  { content: '.'; }
    50%  { content: '..'; }
    75%  { content: '...'; }
  }
  .loading-bar-wrap {
    margin-top: 2rem;
    width: 300px;
    height: 2px;
    background: rgba(245,240,232,0.1);
  }
  .loading-bar {
    height: 100%;
    background: linear-gradient(90deg, var(--gold), var(--accent));
    width: 0%;
    transition: width 0.4s ease;
  }

  #screen-game {
    flex-direction: row;
    min-height: 100vh;
    background: #100e0b;
  }

  .sidebar {
    width: 280px;
    min-width: 280px;
    border-right: 1px solid rgba(196,184,154,0.15);
    display: flex;
    flex-direction: column;
    background: #0d0b08;
    position: sticky;
    top: 0;
    height: 100vh;
    overflow-y: auto;
  }
  .sidebar-header {
    padding: 24px 20px 20px;
    border-bottom: 1px solid rgba(196,184,154,0.12);
  }
  .sidebar-logo {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 26px;
    letter-spacing: 0.1em;
    color: var(--gold);
    line-height: 1;
  }
  .sidebar-case-id {
    font-size: 10px;
    letter-spacing: 0.25em;
    color: var(--muted);
    margin-top: 4px;
  }

  .score-panel {
    padding: 16px 20px;
    border-bottom: 1px solid rgba(196,184,154,0.12);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .score-item label {
    font-size: 9px;
    letter-spacing: 0.3em;
    color: var(--muted);
    display: block;
    margin-bottom: 4px;
    text-transform: uppercase;
  }
  .score-item .val {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 28px;
    color: var(--paper);
    line-height: 1;
  }
  .score-item.accent .val { color: var(--gold); }

  .sidebar-nav { padding: 16px 12px; flex: 1; }
  .nav-section-label {
    font-size: 9px;
    letter-spacing: 0.35em;
    color: var(--muted);
    text-transform: uppercase;
    padding: 0 8px;
    margin-bottom: 8px;
  }
  .nav-btn {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    padding: 11px 12px;
    background: transparent;
    border: none;
    color: var(--muted-light);
    font-family: 'Courier Prime', monospace;
    font-size: 13px;
    cursor: pointer;
    text-align: left;
    border-radius: 2px;
    transition: all 0.15s;
    letter-spacing: 0.05em;
    margin-bottom: 2px;
    position: relative;
  }
  .nav-btn .icon { font-size: 16px; width: 20px; text-align: center; }
  .nav-btn:hover { background: rgba(245,240,232,0.06); color: var(--paper); }
  .nav-btn.active { background: rgba(184,150,42,0.12); color: var(--gold); }
  .nav-btn.active::before {
    content: '';
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 2px;
    background: var(--gold);
  }
  .nav-btn .badge {
    margin-left: auto;
    font-size: 10px;
    background: var(--accent);
    color: var(--paper);
    padding: 2px 7px;
    border-radius: 10px;
    font-family: 'Courier Prime', monospace;
  }
  .nav-btn-accuse {
    margin-top: 8px;
    background: rgba(200,57,43,0.1);
    color: var(--accent);
    border: 1px solid rgba(200,57,43,0.25);
  }
  .nav-btn-accuse:hover { background: rgba(200,57,43,0.2); color: #e85a4a; }

  .sidebar-bottom {
    padding: 16px 20px;
    border-top: 1px solid rgba(196,184,154,0.12);
  }
  .hint-cost {
    font-size: 10px;
    color: var(--muted);
    text-align: center;
    margin-top: 8px;
  }

  .main-content {
    flex: 1;
    padding: 32px 36px;
    overflow-y: auto;
  }

  .panel { display: none; animation: panelIn 0.25s ease; }
  .panel.active { display: block; }
  @keyframes panelIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }

  .panel-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 42px;
    letter-spacing: 0.06em;
    color: var(--paper);
    line-height: 1;
    margin-bottom: 4px;
  }
  .panel-subtitle {
    font-size: 12px;
    letter-spacing: 0.2em;
    color: var(--muted);
    text-transform: uppercase;
    margin-bottom: 28px;
  }
  .panel-divider {
    height: 1px;
    background: linear-gradient(90deg, var(--gold), transparent);
    margin-bottom: 28px;
    opacity: 0.5;
  }

  .case-stamp {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 100px;
    color: var(--accent);
    opacity: 0.06;
    letter-spacing: 0.05em;
    line-height: 1;
    float: right;
    margin-top: -20px;
  }
  .case-narrative {
    font-family: 'Playfair Display', serif;
    font-size: 17px;
    line-height: 1.85;
    color: var(--paper);
    max-width: 640px;
    margin-bottom: 28px;
  }
  .case-narrative p { margin-bottom: 1.1em; }
  .case-narrative p:last-child { margin-bottom: 0; }

  .info-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-bottom: 28px;
  }
  .info-card {
    border: 1px solid rgba(196,184,154,0.2);
    padding: 16px;
    background: rgba(245,240,232,0.03);
    position: relative;
  }
  .info-card::after {
    content: '';
    position: absolute;
    bottom: 0; left: 0;
    width: 40px; height: 2px;
    background: var(--gold);
    opacity: 0.5;
  }
  .info-card label {
    font-size: 9px;
    letter-spacing: 0.3em;
    color: var(--muted);
    text-transform: uppercase;
    display: block;
    margin-bottom: 6px;
  }
  .info-card .info-val {
    font-size: 14px;
    color: var(--paper);
    line-height: 1.4;
  }

  .suspects-grid { display: flex; flex-direction: column; gap: 16px; }

  .suspect-card {
    border: 1px solid rgba(196,184,154,0.18);
    background: rgba(245,240,232,0.02);
    padding: 0;
    position: relative;
    transition: border-color 0.2s;
    cursor: pointer;
    overflow: hidden;
  }
  .suspect-card:hover { border-color: rgba(184,150,42,0.4); }
  .suspect-card.interrogated { border-color: rgba(184,150,42,0.25); }

  .suspect-card-inner { padding: 20px 24px; display: flex; align-items: flex-start; gap: 20px; }
  .suspect-avatar {
    width: 52px;
    height: 52px;
    min-width: 52px;
    border: 1px solid rgba(196,184,154,0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 22px;
    color: var(--gold);
    background: rgba(184,150,42,0.06);
    position: relative;
  }
  .suspect-avatar .initials { line-height: 1; }

  .suspect-info { flex: 1; }
  .suspect-name {
    font-family: 'Playfair Display', serif;
    font-size: 20px;
    font-weight: 700;
    color: var(--paper);
    margin-bottom: 2px;
  }
  .suspect-personality {
    font-size: 11px;
    letter-spacing: 0.2em;
    color: var(--muted);
    text-transform: uppercase;
    margin-bottom: 10px;
  }

  .suspicion-bar-wrap { margin-bottom: 10px; }
  .suspicion-bar-label {
    display: flex;
    justify-content: space-between;
    font-size: 10px;
    letter-spacing: 0.15em;
    color: var(--muted);
    margin-bottom: 5px;
    text-transform: uppercase;
  }
  .suspicion-bar-track {
    height: 4px;
    background: rgba(245,240,232,0.08);
    overflow: hidden;
  }
  .suspicion-bar-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--gold), var(--accent));
    transition: width 0.5s cubic-bezier(0.4,0,0.2,1);
  }

  .suspect-alibi {
    font-family: 'Playfair Display', serif;
    font-style: italic;
    font-size: 14px;
    color: var(--muted-light);
    line-height: 1.6;
    border-left: 2px solid rgba(196,184,154,0.2);
    padding-left: 14px;
    margin-top: 10px;
    display: none;
  }
  .suspect-card.interrogated .suspect-alibi { display: block; }

  .suspect-tag {
    font-size: 9px;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    padding: 3px 10px;
    border: 1px solid;
    position: absolute;
    top: 16px;
    right: 16px;
  }
  .suspect-tag.yes { border-color: var(--gold); color: var(--gold); }
  .suspect-tag.no { border-color: rgba(196,184,154,0.2); color: var(--muted); }

  .interrogate-btn-row {
    padding: 0 24px 20px;
    display: flex;
    gap: 12px;
    justify-content: flex-end;
  }

  .evidence-list { display: flex; flex-direction: column; gap: 16px; }

  .evidence-card {
    border: 1px solid rgba(196,184,154,0.15);
    background: rgba(245,240,232,0.02);
    padding: 20px 24px;
    position: relative;
    transition: border-color 0.25s;
  }
  .evidence-card.examined { border-color: rgba(45,106,79,0.35); }
  .evidence-card:not(.examined) { cursor: pointer; }
  .evidence-card:not(.examined):hover { border-color: rgba(196,184,154,0.35); }

  .evidence-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 10px;
  }
  .evidence-title {
    font-family: 'Playfair Display', serif;
    font-size: 17px;
    font-weight: 700;
    color: var(--paper);
  }
  .evidence-status {
    font-size: 9px;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    padding: 3px 10px;
    border: 1px solid;
    white-space: nowrap;
  }
  .evidence-status.examined { border-color: rgba(45,106,79,0.5); color: var(--green-clue); }
  .evidence-status.new { border-color: rgba(200,57,43,0.4); color: var(--accent); animation: pulse-border 2s infinite; }
  @keyframes pulse-border { 0%,100% { opacity: 1; } 50% { opacity: 0.5; } }

  .evidence-desc {
    font-size: 14px;
    color: var(--muted-light);
    line-height: 1.65;
    margin-bottom: 10px;
  }
  .evidence-detail {
    font-family: 'Playfair Display', serif;
    font-style: italic;
    font-size: 14px;
    color: var(--gold);
    line-height: 1.6;
    display: none;
    border-top: 1px solid rgba(196,184,154,0.12);
    padding-top: 12px;
    margin-top: 4px;
  }
  .evidence-card.examined .evidence-detail { display: block; }
  .evidence-hint { font-size: 11px; color: var(--muted); letter-spacing: 0.1em; margin-top: 8px; }

  .notebook-paper {
    background: #faf6ed;
    border: 1px solid var(--border);
    color: var(--ink);
    padding: 32px 36px 36px;
    max-width: 660px;
    position: relative;
    box-shadow: 4px 4px 0 rgba(0,0,0,0.3);
  }
  .notebook-paper::before {
    content: '';
    position: absolute;
    left: 72px; top: 0; bottom: 0;
    width: 1px;
    background: rgba(200,57,43,0.2);
  }
  .notebook-header {
    font-family: 'Playfair Display', serif;
    font-size: 22px;
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 20px;
    padding-left: 50px;
    border-bottom: 1px solid rgba(0,0,0,0.1);
    padding-bottom: 12px;
  }
  .notebook-entry {
    font-family: 'Courier Prime', monospace;
    font-size: 14px;
    line-height: 2;
    color: #2a2018;
    padding-left: 50px;
    border-bottom: 1px solid rgba(0,0,0,0.05);
    padding-top: 2px;
    padding-bottom: 2px;
  }
  .notebook-entry::before {
    content: '→ ';
    color: var(--accent);
  }
  .notebook-empty {
    font-family: 'Playfair Display', serif;
    font-style: italic;
    color: var(--muted);
    padding-left: 50px;
    font-size: 15px;
    line-height: 2;
  }
  .notebook-stamp {
    position: absolute;
    top: 20px;
    right: 20px;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 48px;
    color: var(--accent);
    opacity: 0.08;
    transform: rotate(-8deg);
    letter-spacing: 0.05em;
  }

  .modal-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.85);
    z-index: 1000;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }
  .modal-overlay.open { display: flex; }

  .modal-box {
    background: #0d0b08;
    border: 1px solid rgba(196,184,154,0.25);
    max-width: 560px;
    width: 100%;
    position: relative;
    animation: modalIn 0.3s ease;
  }
  @keyframes modalIn { from { opacity:0; transform: scale(0.96) translateY(10px); } to { opacity:1; transform: scale(1) translateY(0); } }

  .modal-header {
    padding: 20px 24px 16px;
    border-bottom: 1px solid rgba(196,184,154,0.12);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .modal-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 28px;
    letter-spacing: 0.08em;
    color: var(--paper);
  }
  .modal-close {
    background: none;
    border: 1px solid rgba(196,184,154,0.2);
    color: var(--muted-light);
    width: 28px;
    height: 28px;
    cursor: pointer;
    font-family: 'Courier Prime', monospace;
    font-size: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.15s;
  }
  .modal-close:hover { border-color: var(--accent); color: var(--accent); }

  .modal-body { padding: 24px; }

  .interrogation-spinner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    padding: 20px;
  }
  .spinner-ring {
    width: 48px; height: 48px;
    border: 2px solid rgba(184,150,42,0.2);
    border-top-color: var(--gold);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }
  .spinner-label {
    font-size: 11px;
    letter-spacing: 0.3em;
    color: var(--muted);
    text-transform: uppercase;
  }

  .alibi-text {
    font-family: 'Playfair Display', serif;
    font-style: italic;
    font-size: 17px;
    line-height: 1.9;
    color: var(--paper);
    border-left: 2px solid var(--gold);
    padding-left: 20px;
    margin-bottom: 20px;
  }
  .suspicion-result {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
    background: rgba(245,240,232,0.04);
    border: 1px solid rgba(196,184,154,0.12);
  }
  .suspicion-result-label { font-size: 11px; letter-spacing: 0.2em; color: var(--muted); text-transform: uppercase; }
  .suspicion-result-val { font-family: 'Bebas Neue', sans-serif; font-size: 32px; color: var(--gold); line-height: 1; }
  .suspicion-result-desc { font-size: 12px; color: var(--muted-light); margin-top: 2px; }

  .accuse-suspects { display: flex; flex-direction: column; gap: 10px; margin-bottom: 28px; }
  .accuse-option {
    display: flex;
    align-items: center;
    gap: 16px;
