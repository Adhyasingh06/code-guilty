<script>
  // Add this at top (GLOBAL)
let seed = 12345; // you can sync this with Java

function seededRandom() {
  seed = (seed * 9301 + 49297) % 233280;
  return seed / 233280;
}
// ═══════════════════════════════════════════════════════
//  GAME STATE
// ═══════════════════════════════════════════════════════
const GS = {
  score: 100,
  actions: 0,
  startTime: 0,
  realCulprit: '',
  caseId: '',
  caseTitle: '',
  suspects: [],
  evidence: [],
  notebook: [],
  accusedName: null,
};

// ═══════════════════════════════════════════════════════
//  API — GENERATE CASE WITH JAVA
// ═══════════════════════════════════════════════════════
function generateCaseLikeJava() {

  const namePool = [
    "John", "Alice", "Mark", "Sophia",
    "David", "Emma", "Liam", "Olivia",
    "Noah", "Ava", "Ethan", "Mia"
  ];

  const personalityPool = ["Calm", "Nervous", "Aggressive", "Calculating"];

  // Shuffle names
  const shuffledNames = [...namePool].sort(() => seededRandom() - 0.5);

  // Pick 4 suspects
  const suspects = shuffledNames.slice(0, 4).map(name => ({
    name,
    personality: personalityPool[Math.floor(seededRandom() * personalityPool.length)],
    alibi: "",
    interrogationResponse: "",
    isLying: false
  }));

  // Shuffle suspects again
  suspects.sort(() => seededRandom() - 0.5);

  // Pick culprit
  const culprit = suspects[Math.floor(seededRandom() * suspects.length)].name;

  // Assign lying behavior
  suspects.forEach(s => {
    if (s.name === culprit) {
      s.isLying = true;
    } else {
      s.isLying = Math.random() < 0.25;
    }
  });

  const caseType = Math.floor(seededRandom() * 3);
  let evidence = [];

  function addEvidence(strongTitle, strongDetail, weakDetail) {
    suspects.forEach(s => {
      if (s.name === culprit) {
        evidence.push({
          title: strongTitle,
          description: strongTitle,
          relatedSuspect: s.name,
          detail: strongDetail,
          isStrong: true
        });
      } else {
        if (Math.random() < 0.5) {
          evidence.push({
            title: "🔍 Minor clue",
            description: weakDetail + " (" + s.name + ")",
            relatedSuspect: s.name,
            detail: weakDetail,
            isStrong: false
          });
        }
      }
    });
  }

  // Assign alibis + evidence
  if (caseType === 0) {
    suspects[0].alibi = "I was in the kitchen, washing dishes.\nThe silence felt unnatural.\nI stayed there... I think.";
    suspects[1].alibi = "I was on a call in my room.\nThe line suddenly cut off.\nI stepped outside briefly.";
    suspects[2].alibi = "I argued with him earlier.\nI went to the balcony to cool off.\nWhen I came back... it was over.";
    suspects[3].alibi = "I was reading in the library.\nI didn't hear anything unusual.\nBooks were my only company.";

   addEvidence("🔪 Blood-stained knife", "Fingerprints match the culprit.", "Dinner presence — nothing conclusive.");
        addEvidence("🍷 Overturned glass", "Wine suggests a struggle occurred.", "No sign of altercation near them.");

  } else if (caseType === 1) {
    suspects[0].alibi = "I was going through financial papers.\nDisagreements about money.\nI never left the study.";
    suspects[1].alibi = "I heard something strange downstairs.\nI ignored it at first.\nMaybe I should have checked.";
    suspects[2].alibi = "I was outside taking a heated call.\nI wasn't paying attention.\nI didn't hear anything.";
    suspects[3].alibi =  "I was preparing tea in the kitchen.\nNothing stood out to me.\nI went to bed early.";

    addEvidence("📄 Forged document", "Signature is manipulated — benefits the culprit.", "Had document access but no manipulation found.");
        addEvidence("💰 Missing cheque", "Cheque amount matches culprit's debt.", "No financial motive established.");
  } else {
    suspects[0].alibi = "I was texting the entire time.\nYou can check my records.\nI didn't move from my spot.";
    suspects[1].alibi = "My call got disconnected.\nI stepped out briefly to fix it.\nThat's all.";
    suspects[2].alibi = "I was resting quietly.\nNothing unusual happened.\nJust another night.";
    suspects[3].alibi = "I was in the garden.\nI heard a car, nothing more.\nI came in when it got cold.";

    addEvidence("📱 Location mismatch", "Phone data contradicts culprit's alibi. Movement near scene.", "Phone activity normal — no unusual movement.");
        addEvidence("🔦 Torch found", "Torch has culprit's DNA on grip.", "No connection to torch established.");
  }

  return {
    caseId: Math.floor(1000 + seededRandom() * 9000).toString(),
    caseTitle: "Randomized Case File",
    setting: "Secluded mansion",
    victim: "Unknown Victim",
    time: "Late Night",
    method: "Undetermined",
    narrative: `
<p>A crime has shattered the silence of a secluded mansion.</p>
<p>The victim was found late at night under suspicious circumstances.
There were no signs of forced entry — meaning the killer is someone inside.</p>
<p>All four suspects were present at the scene. Each has a motive.
Each has something to hide.</p>
<p>Your job, Detective, is to uncover the truth using:
evidence, interrogation, and logic.</p>
<p>Be careful — not everyone is telling the truth.</p>
`,
    culprit,
    suspects,
    evidence,
    culpritConfession: "Fine. I did it. It wasn't supposed to happen like this."
  };
}
// ═══════════════════════════════════════════════════════
//  SCREEN MANAGEMENT
// ═══════════════════════════════════════════════════════
function showScreen(id) {
  document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
  document.getElementById('screen-' + id).classList.add('active');
}

function showPanel(id, chargeAction = false) {
  document.querySelectorAll('.panel').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active'));
  document.getElementById('panel-' + id).classList.add('active');
  const nb = document.querySelector(`[data-panel="${id}"]`);
  if (nb) nb.classList.add('active');

  // ── CHANGE 1 ──────────────────────────────────────────────────────────────
  // Java deducts 2 pts for EVERY menu action including viewing panels.
  // HTML previously never charged for panel switches. Now we charge -2 per
  // nav click (chargeAction=true), matching Java's "score -= 2 per choice".
  if (chargeAction) {
    GS.actions++;
    GS.score = Math.max(0, GS.score - 2);
    updateScore();
  }
  // ─────────────────────────────────────────────────────────────────────────

  logNotebook(`Opened ${id.charAt(0).toUpperCase() + id.slice(1)} panel.`);
}

// ═══════════════════════════════════════════════════════
//  GAME FLOW
// ═══════════════════════════════════════════════════════
async function startNewGame() {
  showScreen('loading');
  setLoadingStatus('Contacting dispatch...', 10);

  await sleep(400);
  setLoadingStatus('Generating crime scene...', 30);

  let caseData;
  try {
    setLoadingStatus('AI writing your unique case...', 55);
    caseData = generateCaseLikeJava();
    setLoadingStatus('Assembling case file...', 80);
    await sleep(400);
    setLoadingStatus('Briefing detective...', 95);
    await sleep(300);
  } catch (e) {
    console.error('AI failed, using fallback:', e);
    caseData = getFallbackCase();
  }

  loadCase(caseData);
  setLoadingStatus('Ready.', 100);
  await sleep(300);
  showScreen('game');
  showPanel('brief');
}

function loadCase(data) {
  GS.score = 100;
  GS.actions = 0;
  GS.startTime = Date.now();
  GS.realCulprit = data.culprit;
  GS.caseId = data.caseId;
  GS.caseTitle = data.caseTitle;
  GS.notebook = [];
  GS.accusedName = null;

  GS.suspects = data.suspects.map(s => ({
    ...s,
    suspicionScore: 0,
    interrogated: false,
  }));

  GS.evidence = data.evidence.map(e => ({
    ...e,
    examined: false,
  }));

  GS.culpritConfession = data.culpritConfession;
  GS.caseMetaData = data;

  renderBrief(data);
  renderSuspects();
  renderEvidence();
  renderNotebook();
  updateScore();

  document.getElementById('sidebar-case-id').textContent =
    `Case #${data.caseId} — ${data.caseTitle}`;
  document.getElementById('evidence-badge').textContent = '0';
}

// ═══════════════════════════════════════════════════════
//  RENDER FUNCTIONS
// ═══════════════════════════════════════════════════════
function renderBrief(data) {
  document.getElementById('brief-subtitle').textContent =
    `Case #${data.caseId} — ${data.caseTitle} — Classified`;

  const narr = document.getElementById('brief-narrative');
  narr.innerHTML = data.narrative;

  const grid = document.getElementById('brief-info-grid');
  grid.innerHTML = [
    { label: 'Setting', val: data.setting },
    { label: 'Victim', val: data.victim },
    { label: 'Time of Death', val: data.time },
    { label: 'Cause of Death', val: data.method },
    { label: 'Suspects', val: '4 Persons of Interest' },
    { label: 'Status', val: 'Case Open — Active Investigation' },
  ].map(i => `
    <div class="info-card">
      <label>${i.label}</label>
      <div class="info-val">${i.val}</div>
    </div>`).join('');
}

function renderSuspects() {
  const grid = document.getElementById('suspects-grid');
  grid.innerHTML = GS.suspects.map((s, i) => {
    const initials = s.name.split(' ').map(w => w[0]).join('').slice(0, 2).toUpperCase();
    const barPct = Math.min((s.suspicionScore / 100) * 100, 100);
    return `
    <div class="suspect-card ${s.interrogated ? 'interrogated' : ''}" id="suspect-card-${i}">
      <div class="suspect-card-inner">
        <div class="suspect-avatar"><span class="initials">${initials}</span></div>
        <div class="suspect-info">
          <div class="suspect-name">${s.name}</div>
          <div class="suspect-personality">${s.personality}</div>
          <div class="suspicion-bar-wrap">
            <div class="suspicion-bar-label">
              <span>Suspicion Level</span>
              <span>${s.suspicionScore} pts</span>
            </div>
            <div class="suspicion-bar-track">
              <div class="suspicion-bar-fill" style="width:${barPct}%"></div>
            </div>
          </div>
          ${s.interrogated ? `
          <div class="suspect-alibi">${s.interrogationResponse || s.alibi}</div>` : ''}
        </div>
      </div>
      <div class="interrogate-btn-row">
        ${s.interrogated
          ? `<span class="suspect-tag yes">&#10004; Interrogated</span>`
          : `<button class="btn btn-sm" onclick="openInterrogation(${i})">Interrogate</button>`
        }
      </div>
    </div>`;
  }).join('');

  renderAccuseOptions();
}

function renderAccuseOptions() {
  const grid = document.getElementById('accuse-suspects');
  grid.innerHTML = GS.suspects.map((s, i) => `
    <button class="accuse-option" data-idx="${i}" onclick="selectAccuse(${i})">
      <div>
        <div class="opt-name">${s.name}</div>
        <div class="opt-personality">${s.personality}</div>
      </div>
      <div class="opt-score">${s.suspicionScore} pts suspicion</div>
    </button>`).join('');
  document.getElementById('btn-confirm-accuse').disabled = true;
  GS.accusedName = null;
}

function selectAccuse(idx) {
  document.querySelectorAll('.accuse-option').forEach(o => o.classList.remove('selected'));
  document.querySelectorAll('.accuse-option')[idx].classList.add('selected');
  GS.accusedName = GS.suspects[idx].name;
  document.getElementById('btn-confirm-accuse').disabled = false;
}

function renderEvidence() {
  const list = document.getElementById('evidence-list');
  list.innerHTML = GS.evidence.map((e, i) => `
    <div class="evidence-card ${e.examined ? 'examined' : ''}" id="evidence-card-${i}"
      onclick="${e.examined ? '' : `examineEvidence(${i})`}">
      <div class="evidence-header">
        <div class="evidence-title">${e.title}</div>
        <div class="evidence-status ${e.examined ? 'examined' : 'new'}">
          ${e.examined ? '&#10004; Examined' : 'New'}
        </div>
      </div>
      <div class="evidence-desc">${e.description}</div>
      ${e.examined
        ? `<div class="evidence-detail">${e.detail}</div>`
        : `<div class="evidence-hint">Click to examine this piece of evidence</div>`
      }
    </div>`).join('');
}

function renderNotebook() {
  const el = document.getElementById('notebook-entries');
  if (GS.notebook.length === 0) {
    el.innerHTML = '<div class="notebook-empty">Begin investigating to see notes appear here.</div>';
  } else {
    el.innerHTML = GS.notebook.map(e =>
      `<div class="notebook-entry">${e}</div>`).join('');
  }
}

// ═══════════════════════════════════════════════════════
//  ACTIONS
// ═══════════════════════════════════════════════════════
async function openInterrogation(idx) {
  const suspect = GS.suspects[idx];
  if (suspect.interrogated) return;

  const modal = document.getElementById('modal-interrogate');
  const body = document.getElementById('modal-body');
  document.getElementById('modal-suspect-name').textContent =
    `Interrogating ${suspect.name}`;

  body.innerHTML = `
    <div class="interrogation-spinner">
      <div class="spinner-ring"></div>
      <div class="spinner-label">Applying pressure...</div>
    </div>`;
  modal.classList.add('open');

  await sleep(1800);

  // ── CHANGE 2 ──────────────────────────────────────────────────────────────
  // Java personality bonuses: Nervous=15, Aggressive=10, Calculating=12, Calm=5.
  // Previous HTML also had Evasive=14 and Charming=8, which don't exist in Java.
  // These are removed. Only the 4 Java personalities are used now.
  // Default fallback stays 5 (same as Java's "default" case).
  const personalityBonus = {
  'Nervous': 18,
  'Aggressive': 12,
  'Calculating': 10,
  'Calm': 6
};
  // ─────────────────────────────────────────────────────────────────────────

  const bonus = personalityBonus[suspect.personality] ?? 5;
  suspect.suspicionScore += bonus;
  suspect.interrogated = true;
  if (suspect.isLying) {
  suspect.suspicionScore += 20; // BIG penalty for lying
}

  // ── CHANGE 3 ──────────────────────────────────────────────────────────────
  // Java deducts exactly 2 pts per action (score -= 2 in handleChoice).
  // Previous HTML called cost(3) here, deducting 3 pts for interrogation.
  // Corrected to cost(2) to match Java's flat -2 per action rule.
  cost(2);
  // ─────────────────────────────────────────────────────────────────────────

 let alibiText = suspect.alibi;

if (suspect.isLying) {
  alibiText += " (Their statement feels inconsistent...)";
}
  const responseText = suspect.interrogationResponse || '';

  body.innerHTML = `
    <div class="alibi-text" id="modal-alibi">${alibiText}</div>
    ${responseText ? `
    <div style="margin-bottom:16px; padding:12px 16px; background:rgba(200,57,43,0.06); border-left:2px solid var(--accent);">
      <div style="font-size:10px; letter-spacing:0.2em; color:var(--muted); text-transform:uppercase; margin-bottom:6px;">Under Pressure</div>
      <div style="font-family:'Playfair Display',serif; font-style:italic; font-size:14px; color:var(--paper); line-height:1.65;">${responseText}</div>
    </div>` : ''}
    <div class="suspicion-result">
      <div>
        <div class="suspicion-result-label">Suspicion Score</div>
        <div class="suspicion-result-val">${suspect.suspicionScore}</div>
        <div class="suspicion-result-desc">+${bonus} pts from interrogation (${suspect.personality})</div>
      </div>
    </div>`;

  logNotebook(`Interrogated ${suspect.name} [${suspect.personality}] — alibi recorded.`);
  renderSuspects();
}

function examineEvidence(idx) {
  const ev = GS.evidence[idx];
  if (ev.examined) return;

  ev.examined = true;

  // ── CHANGE 4 ──────────────────────────────────────────────────────────────
  // Java awards culprit's evidence +25 suspicion pts, others +8.
  // This was already correct in the HTML. Confirmed and kept as-is.
  GS.suspects.forEach(s => {
    if (s.name === ev.relatedSuspect) {
      const pts = ev.isStrong ? 30 : 6;
      s.suspicionScore += pts;
    }
  });
  // ─────────────────────────────────────────────────────────────────────────

  cost(2);

  const examined = GS.evidence.filter(e => e.examined).length;
  document.getElementById('evidence-badge').textContent = examined;

  renderEvidence();
  renderSuspects();
  logNotebook(`Examined evidence: "${ev.title}".`);
}

function requestHint() {
  // ── CHANGE 5 ──────────────────────────────────────────────────────────────
  // Java: score -= 5 for hint, then also score -= 2 for the menu action itself.
  // Previous HTML: called cost(1, false) which deducted 1 EXTRA point on top
  // of the -5, making it -6 total — wrong. Now we do exactly: -5 for hint,
  // count as 1 action, -2 action penalty = -7 total, matching Java's -5 hint
  // cost + -2 action cost = -7 total per hint request.
  GS.score = Math.max(0, GS.score - 5);
  GS.actions++;
  GS.score = Math.max(0, GS.score - 2);
  updateScore();
  // ─────────────────────────────────────────────────────────────────────────

  const top = GS.suspects.reduce((a, b) => a.suspicionScore > b.suspicionScore ? a : b);
  const toast = document.getElementById('hint-toast');
  const text = document.getElementById('hint-toast-text');

  if (top.suspicionScore > 0) {
    text.textContent = `Evidence points most strongly toward ${top.name} (${top.suspicionScore} pts suspicion). But trust the evidence, not just the score.`;
  } else {
    text.textContent = 'Examine all evidence and interrogate every suspect before making your accusation.';
  }

  toast.classList.add('show');
  logNotebook('Requested a detective hint (−5 pts).');
  setTimeout(() => toast.classList.remove('show'), 5000);
}

function confirmAccusation() {
  if (!GS.accusedName) return;

  const elapsed = Math.round((Date.now() - GS.startTime) / 1000);

  // ── CHANGE 6 ──────────────────────────────────────────────────────────────
  // Java time bonus: elapsed < 120s = +20, elapsed < 300s = +10, else 0.
  // This was already correct in the HTML. Confirmed and kept as-is.
  const timeBonus = elapsed < 120 ? 20 : elapsed < 300 ? 10 : 0;
  // ─────────────────────────────────────────────────────────────────────────

  const correct = GS.accusedName.toLowerCase() === GS.realCulprit.toLowerCase();

  if (correct) {
    GS.score = Math.min(GS.score + timeBonus, 999);
    showVerdict(true, elapsed, timeBonus);
  } else {
    // ── CHANGE 7 ──────────────────────────────────────────────────────────
    // Java deducts 30 pts for wrong accusation. Already correct. Kept as-is.
    GS.score = Math.max(0, GS.score - 30);
    // ───────────────────────────────────────────────────────────────────────
    showVerdict(false, elapsed, 0);
  }
}

function showVerdict(correct, elapsed, bonus) {
  const glow = document.getElementById('verdict-glow');
  const stamp = document.getElementById('verdict-stamp');
  const headline = document.getElementById('verdict-headline');
  const sub = document.getElementById('verdict-sub');
  const conf = document.getElementById('verdict-confession');

  glow.className = 'verdict-glow ' + (correct ? 'correct' : 'wrong');
  stamp.className = 'verdict-stamp ' + (correct ? 'correct' : 'wrong');

  if (correct) {
    stamp.innerHTML = 'CASE<br>SOLVED';
    headline.textContent = `${GS.accusedName} — Guilty as Charged`;
    sub.textContent = `Your instincts and evidence led to justice.${bonus > 0 ? ` Speed bonus of +${bonus} pts awarded.` : ''} The department commends your work.`;
    conf.innerHTML = `<strong style="color:var(--gold);font-style:normal;">${GS.realCulprit}:</strong> ${GS.culpritConfession}`;
  } else {
    stamp.innerHTML = 'CASE<br>FAILED';
    headline.textContent = `${GS.accusedName} — Wrongly Accused`;
    sub.textContent = `The real culprit was ${GS.realCulprit}. They slipped away while you pursued the wrong lead. −30 points.`;
    conf.innerHTML = `<strong style="color:var(--accent);font-style:normal;">The Truth:</strong> ${GS.realCulprit} was the murderer. The case remains unsolved in the public record.`;
  }

  document.getElementById('vs-score').textContent = GS.score;
  document.getElementById('vs-actions').textContent = GS.actions;
  document.getElementById('vs-time').textContent = `${elapsed}s`;

  showScreen('verdict');
}

// ═══════════════════════════════════════════════════════
//  HELPERS
// ═══════════════════════════════════════════════════════
function cost(actionPenalty, countAction = true) {
  if (countAction) GS.actions++;
  GS.score = Math.max(0, GS.score - actionPenalty);
  updateScore();
}

function updateScore() {
  document.getElementById('score-display').textContent = GS.score;
  document.getElementById('action-display').textContent = GS.actions;
}

function logNotebook(entry) {
  GS.notebook.push(entry);
  renderNotebook();
}

function sleep(ms) { return new Promise(r => setTimeout(r, ms)); }

function setLoadingStatus(msg, pct) {
  document.getElementById('loading-status').textContent = msg;
  document.getElementById('loading-bar').style.width = pct + '%';
}

function goToTitle() {
  showScreen('title');
}

function showHowToPlay() {
  alert(
    'HOW TO PLAY — CODE: GUILTY\n\n' +
    '1. Read the Case Brief to understand the crime\n' +
    '2. Interrogate suspects to hear their alibis\n' +
    '3. Examine Evidence to raise suspicion scores\n' +
    '4. Use your Notebook to track findings\n' +
    '5. Request a Hint if stuck (costs 5 pts + 2 action penalty)\n' +
    '6. Make your Accusation when ready\n\n' +
    'SCORING:\n' +
    '• Start with 100 points\n' +
    '• Each action costs 2 points\n' +
    '• Hints cost 5 extra points\n' +
    '• Wrong accusation: −30 points\n' +
    '• Fast solve bonus: up to +20 points\n\n' +
    'Every case is uniquely AI-generated.'
  );
}

